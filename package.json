{
  "name": "playwright-ui-api-tests",
  "version": "1.0.0",
  "description": "UI and API test automation for a demo web shop, built with Playwright and TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:known-bugs": "playwright test --project=known-bugs",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
